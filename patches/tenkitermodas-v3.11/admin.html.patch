+  /* ===================== v3.11 (CAD-02): rascunho incremental do formulário =====================
+   * O cadastro é longo (fotos, nome, preço, gênero, categoria, tamanhos, cores, descrição). Se a
+   * pessoa fechar o app, trocar de tela ou o celular descarregar no meio, tudo se perdia. Agora os
+   * CAMPOS DE TEXTO e as escolhas (gênero/categoria) são salvos sozinhos no aparelho enquanto ela
+   * digita e voltam na próxima abertura, com aviso e botão de descartar. As FOTOS não entram aqui
+   * (base64 é grande demais para o armazenamento do navegador) — elas seguem no fluxo de envio. */
+  const RASCUNHO_CHAVE = 'tenkiter_rascunho_form_v1';
+  let rascunhoTimer_ = null;
+
+  function camposDoRascunho_() {
+    return {
+      nome: document.getElementById('nome').value,
+      preco: document.getElementById('preco').value,
+      estoque: document.getElementById('estoque').value,
+      tamanhos: document.getElementById('tamanhos').value,
+      cores: document.getElementById('cores').value,
+      descricao: document.getElementById('descricao').value,
+      novidade: document.getElementById('novidade').checked,
+      categorias: Array.from(selecionadasCategorias),
+      generos: Array.from(selecionadosGeneros)
+    };
+  }
+  function rascunhoVazio_(r) {
+    if (!r) return true;
+    return !(String(r.nome || '').trim() || String(r.preco || '').trim() || String(r.estoque || '').trim() ||
+      String(r.tamanhos || '').trim() || String(r.cores || '').trim() || String(r.descricao || '').trim() ||
+      (r.categorias && r.categorias.length) || (r.generos && r.generos.length) || r.novidade);
+  }
+  function salvarRascunhoForm_() {
+    if (modoFormulario === 'editando') return;   // editar peça existente não vira rascunho
+    try {
+      const r = camposDoRascunho_();
+      if (rascunhoVazio_(r)) { localStorage.removeItem(RASCUNHO_CHAVE); return; }
+      r.salvoEm = Date.now();
+      localStorage.setItem(RASCUNHO_CHAVE, JSON.stringify(r));
+    } catch (e) { /* sem espaço: segue sem rascunho */ }
+  }
+  function agendarRascunho_() {
+    clearTimeout(rascunhoTimer_);
+    rascunhoTimer_ = setTimeout(salvarRascunhoForm_, 600);   // espera a digitação parar
+  }
+  function limparRascunhoForm_() {
+    clearTimeout(rascunhoTimer_);
+    try { localStorage.removeItem(RASCUNHO_CHAVE); } catch (e) {}
+    const av = document.getElementById('rascunho-aviso'); if (av) av.hidden = true;
+  }
+  function restaurarRascunhoForm_() {
+    let r = null;
+    try { r = JSON.parse(localStorage.getItem(RASCUNHO_CHAVE) || 'null'); } catch (e) { r = null; }
+    if (rascunhoVazio_(r) || modoFormulario === 'editando') return;
+    document.getElementById('nome').value = r.nome || '';
+    document.getElementById('preco').value = r.preco || '';
+    document.getElementById('estoque').value = r.estoque || '';
+    document.getElementById('tamanhos').value = r.tamanhos || '';
+    document.getElementById('cores').value = r.cores || '';
+    document.getElementById('descricao').value = r.descricao || '';
+    document.getElementById('novidade').checked = !!r.novidade;
+    selecionadasCategorias = new Set(r.categorias || []);
+    selecionadosGeneros = new Set(r.generos || []);
+    renderizarChips('chips-categoria', categorias, selecionadasCategorias);
+    renderizarChips('chips-genero', generos, selecionadosGeneros);
+    renderizarCategorias_();
+    atualizarFaltas_();
+    const av = document.getElementById('rascunho-aviso');
+    if (av) { document.getElementById('rascunho-aviso-txt').textContent = '📝 Rascunho recuperado do seu último cadastro.'; av.hidden = false; }
+  }
+  (function ligarRascunho_() {
+    const form = document.getElementById('form-produto');
+    if (!form) return;
+    form.addEventListener('input', agendarRascunho_);
+    form.addEventListener('change', agendarRascunho_);
+    const b = document.getElementById('btn-descartar-rascunho');
+    if (b) b.addEventListener('click', () => { limparRascunhoForm_(); cancelarDuplicacao(); });
+    const bc = document.getElementById('btn-cancelar-duplicar');
+    if (bc) bc.addEventListener('click', limparRascunhoForm_);
+  })();
+
