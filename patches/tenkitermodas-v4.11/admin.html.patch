+      + '<button type="button" class="cat-salvar" data-esc-salvar>Salvar</button><button type="button" class="cat-cancelar" data-esc-cancelar aria-label="Cancelar">✕</button></div></div>';
+  }
+  function abrirCriacaoEscolha_(chave, texto) {
+    const cfg = CAMPOS_ESCOLHA_[chave];
+    escolhaEditando_[chave] = null;
+    document.getElementById(cfg.nova).classList.add('aberto');
+    [cfg.busca, cfg.lista, cfg.criar].forEach((id) => { const el = document.getElementById(id); if (el) el.style.display = 'none'; });
+    const inp = document.getElementById(cfg.input);
+    inp.value = String(texto || '').replace(/,/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 60).trim();
