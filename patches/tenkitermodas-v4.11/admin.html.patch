+  const CAMROS_ESCOLHA_ = {
+    tamanhos: { overlay: 'overlay-tamanhos', campo: 'tamanhos', chips: 'chips-tamanhos', busca: 'tam-busca', lista: 'tam-lista', criar: 'btn-criar-tamanho', nova: 'nova-tamanho-linha', input: 'input-novo-tamanho', confirmar: 'btn-confirmar-novo-tamanho', previa: 'novo-tam-previa', sugestoes: 'novo-tam-sugestoes', voltar: 'novo-tam-voltar', pronto: 'tam-pronto', abrir: 'btn-abrir-tamanhos', fechar: 'tam-fechar', base: TAMANHOS_RAPIDOS },
+    cores:    { overlay: 'overlay-cores',    campo: 'cores',    chips: 'chips-cores',    busca: 'cor-busca', lista: 'cor-lista', criar: 'btn-criar-cor',    nova: 'nova-cor-linha',    input: 'input-nova-cor',    confirmar: 'btn-confirmar-nova-cor',    previa: 'nova-cor-previa', sugestoes: 'nova-cor-sugestoes', voltar: 'novo-cor-voltar', pronto: 'cor-pronto', abrir: 'btn-abrir-cores',    fechar: 'cor-fechar', base: CORES_RAPIDAS }
+  };
