+    try { inp.setSelectionRange(inp.value.length, inp.value.length); } catch (e) {}
+  }
+  function fecharCriacaoEscolha_(chave) {
+    const cfg = CAMPOS_ESCOLHA_[chave];
+    document.getElementById(cfg.nova).classList.remove('aberto');
+    [cfg.busca, cfg.lista, cfg.criar].forEach((id) => { const el = document.getElementById(id); if (el) el.style.display = ''; });
