+
+  function opcoesEscolha_(chave) {
+    const cfg = CAMPOS_ESCOLHA_[chave];
+    const vistos = new Set(), out = [];
+    cfg.base.concat(escolhaNovas_[chave]).forEach((o) => { const k = semAcento_(o); if (o && !vistos.has(k)) { vistos.add(k); out.push(o); } });
+    return out.sort((a, b) => a.localeCompare(b, 'pt-BR'));
+  }
+  function abrirEscolha_(chave) {
+    const cfg = CAMPOS_ESCOLHA_[chave];
+    escolhaSel_[chave] = new Set(listaDoCampo__(cfg.campo));
+    escolhaTermo_[chave] = '';
+    escolhaEditando_[chave] = null;
+    const b = document.getElementById(cfg.busca); if (b) b.value = '';
+    fecharCriacaoEscolha_(chave);
+    renderizarEscolha_(chave);
+    abrirComHistorico_(cfg.overlay);
+  }
+  function renderizarEscolha_(chave) {
+    const cfg = CAMPOS_ESCOLHA_[chave];
+    const termo = semAcento_(escolhaTermo_[chave]);
+    const lista = opcoesEscolha_(chave).filter((o) => !termo || semAcento_(o).indexOf(termo) !== -1);
+    const box = document.getElementById(cfg.lista);
+    const linha = (o) => {
+      if (escolhaEditando_[chave] === o) return editorEscolha_(chave, o);
+      const marcada = escolhaSel_[chave].has(o);
+      return '<div class="cat-linha"><button type="button" class="cat-item' + (marcada ? ' selecionado' : '') + '" data-esc="' + escaparHtml(o) + '"><span>' + escaparHtml(o) + '</span><span class="marca">' + (marcada ? '✓' : '') + '</span></button>'
+        + '<button type="button" class="cat-acao cat-ed" data-esc-editar="' + escaparHtml(o) + '" aria-label="Corrigir ' + escaparHtml(o) + '" title="Corrigir">✎</button></div>';
+    };
+    const bruto = String(escolhaTermo_[chave] || '').replace(/,/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 60).trim();
+    const criarCom = bruto && !opcoesEscolha_(chave).some((o) => semAcento_(o) === semAcento_(bruto))
+      ? '<button type="button" class="cat-criar-linha" data-esc-criar="' + escaparHtml(bruto) + '">＋ Criar “' + escaparHtml(bruto) + '”</button>' : '';
+    box.innerHTML = lista.length ? lista.map(linha).join('') + criarCom
+      : '<div class="cat-vazio">' + (termo ? 'Nada com esse nome.' : 'Ainda não há opções.') + '<br>Use o botão abaixo para criar.</div>' + criarCom;
+    const n = escolhaSel_[chave].size;
+    document.getElementById(cfg.pronto).textContent = n ? 'Pronto (' + n + (n === 1 ? ' escolhido)' : ' escolhidos)') : 'Pronto';
+  }
+  function editorEscolha_(chave, o) {
